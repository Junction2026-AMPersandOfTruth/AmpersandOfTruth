@inherits LayoutComponentBase

<div class="aot-shell">
    <header class="aot-appbar">
        <a class="aot-brand" href="/"><em>&amp;</em> Ampersand of Truth</a>
        <div class="aot-appbar__search" data-testid="appbar-search-slot"></div>
        <NavMenu />
    </header>

    <main class="aot-page">
        @Body
    </main>

    <Footer />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

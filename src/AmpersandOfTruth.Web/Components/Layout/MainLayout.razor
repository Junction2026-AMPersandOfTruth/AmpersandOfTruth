@inherits LayoutComponentBase
@implements IDisposable
@using AmpersandOfTruth.Web.Features.Search
@inject NavigationManager Nav

<div class="aot-shell">
    <header class="@AppbarClass">
        <a class="aot-brand" href="/" aria-label="Ampersand of Truth"><em>&amp;</em><span class="aot-brand__name"> Ampersand of Truth</span></a>
        <div class="@SearchSlotClass" data-testid="appbar-search-slot">
            @if (!IsLanding())
            {
                <TopicSearch Compact />
            }
        </div>
        <NavMenu />
        @if (!IsLanding())
        {
            <button type="button"
                    class="aot-btn aot-btn--ghost aot-btn--sm aot-appbar__search-toggle"
                    data-testid="appbar-search-toggle"
                    aria-label="@(_mobileSearchOpen ? "Close search" : "Search a topic")"
                    aria-expanded="@(_mobileSearchOpen ? "true" : "false")"
                    title="@(_mobileSearchOpen ? "Close search" : "Search a topic")"
                    @onclick="ToggleMobileSearch">
                <svg viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    @if (_mobileSearchOpen)
                    {
                        <path d="M4.5 4.5l9 9M13.5 4.5l-9 9" />
                    }
                    else
                    {
                        <circle cx="8" cy="8" r="5" />
                        <path d="M12 12l4 4" />
                    }
                </svg>
            </button>
        }
        <ThemeToggle />
    </header>

    <main class="aot-page">
        @Body
    </main>

    <Footer />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _mobileSearchOpen;

    private string AppbarClass =>
        _mobileSearchOpen && !IsLanding()
            ? "aot-appbar aot-appbar--search-open"
            : "aot-appbar";

    private string SearchSlotClass =>
        _mobileSearchOpen && !IsLanding()
            ? "aot-appbar__search is-open"
            : "aot-appbar__search";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void ToggleMobileSearch() => _mobileSearchOpen = !_mobileSearchOpen;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileSearchOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsLanding()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri);
        var end = rel.IndexOfAny(['?', '#']);
        if (end >= 0) rel = rel[..end];
        return rel.Trim('/').Length == 0;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

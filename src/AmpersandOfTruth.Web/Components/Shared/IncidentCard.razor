@using System.Globalization
@using AmpersandOfTruth.Web.Features.Evidence
@using AmpersandOfTruth.Web.Features.Investigations.Overview
@using AmpersandOfTruth.Web.Features.Investigations.View

@{
    var cardClass = "aot-card" + (Compact ? " aot-card--compact" : "") + (Highlighted ? " is-highlighted" : "");
    var mainLinkClass = "aot-card__main" + (Highlighted ? " is-highlighted" : "");
}

<article class="@cardClass"
         id="incident-@Incident.Id"
         @onmouseenter="HandleMouseEnterAsync"
         @onmouseleave="HandleMouseLeaveAsync">
    <a class="@mainLinkClass"
       href="@Href"
       data-testid="incident-card"
       data-incident="@Incident.Id"
       @onmouseenter="HandleMouseEnterAsync"
       @onmouseleave="HandleMouseLeaveAsync">
        <div class="aot-card__top">
            <TierBadge Tier="Incident.Tier" />
            <span class="aot-small aot-muted" data-testid="incident-article">
                @if (!string.IsNullOrWhiteSpace(Incident.PrimaryArticle.TitleEn))
                {
                    <span>@Incident.PrimaryArticle.TitleEn</span>@if (HasDistinctEnglishTitle(Incident.PrimaryArticle))
                    {
                        <text> (</text><span lang="fi">@Incident.PrimaryArticle.TitleFi</span><text>)</text>
                    }
                }
                else
                {
                    <span lang="fi">@Incident.PrimaryArticle.TitleFi</span><text> (Finnish Wikipedia)</text>
                }
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Incident.ClaimEn))
        {
            <div class="aot-card__mt" data-testid="incident-claim-mt">
                <span class="aot-mt">
                    <span class="aot-mt__tag" title="@Attribution.MachineTranslationNotice">Automated English summary</span>
                </span>
            </div>
        }

        <p class="aot-card__claim" data-testid="incident-claim">@OverviewState.CardHeadline(Incident)</p>

        @if (!string.IsNullOrWhiteSpace(Incident.ClaimOriginal))
        {
            <div class="aot-original" lang="@EffectiveLang" data-testid="incident-original">@Incident.ClaimOriginal</div>
        }

        <p class="aot-card__what" data-testid="incident-what">@OverviewState.WhatHappened(Incident)</p>

        @if (!Compact)
        {
            var factsClass = FirstInsertingRevId is not null ? "aot-facts aot-facts--with-wiki" : "aot-facts";
            <dl class="@factsClass" data-testid="incident-facts">
                <div>
                    <dt>First seen</dt>
                    <dd>@FormatDate(Incident.FirstSeen)</dd>
                </div>
                @if (Incident.LastRemoved is { } lastRemoved)
                {
                    <div>
                        <dt>Last removed</dt>
                        <dd>@FormatDate(lastRemoved)</dd>
                    </div>
                }
                <div>
                    <dt>Live</dt>
                    <dd>@OverviewState.Duration(Incident.TotalLive)</dd>
                </div>
                <div>
                    <dt>Accounts</dt>
                    <dd>@Incident.AccountCount.ToString("N0", CultureInfo.InvariantCulture)</dd>
                </div>
                <div>
                    <dt>Articles</dt>
                    <dd>@Incident.Articles.Count.ToString("N0", CultureInfo.InvariantCulture)</dd>
                </div>
            </dl>
        }
    </a>

    @if (!Compact)
    {
        @if (FirstInsertingRevId is { } diffRevId)
        {
            <div class="aot-card__wiki-row">
                <a class="aot-card__wiki"
                   href="@WikipediaLinks.Diff(diffRevId).AbsoluteUri"
                   target="_blank"
                   rel="noopener noreferrer"
                   data-testid="incident-wiki-diff">View on Wikipedia &#x2197;</a>
            </div>
        }

        @if (Incident.Signals.Count > 0)
        {
            <div class="aot-row">
                @foreach (var signal in Incident.Signals.Take(MaxVisibleSignals))
                {
                    <SignalChip Phrase="signal.Phrase" Evidence="signal.Evidence" />
                }
                @if (Incident.Signals.Count > MaxVisibleSignals)
                {
                    <span class="aot-small aot-muted" data-testid="incident-more-signals">+@((Incident.Signals.Count - MaxVisibleSignals).ToString("N0", CultureInfo.InvariantCulture)) more</span>
                }
            </div>
        }
    }
</article>

@code {
    private const int MaxVisibleSignals = 4;

    [Parameter, EditorRequired] public IncidentView Incident { get; set; } = default!;
    /// <summary>Topic slug of the investigation, for the link.</summary>
    [Parameter, EditorRequired] public string Topic { get; set; } = "";
    /// <summary>Query string to carry to the incident page (e.g. "?sort=recent&tier=2"), or empty.</summary>
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public bool Highlighted { get; set; }
    /// <summary>Smaller variant (no chips, no facts row) for "Related".</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>Raised with the incident id on mouseenter and null on mouseleave.</summary>
    [Parameter] public EventCallback<string?> OnHover { get; set; }

    public static RenderFragment Skeleton { get; } = builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "aot-card aot-card--skeleton");
        builder.AddAttribute(2, "data-testid", "incident-skeleton");
        builder.AddAttribute(3, "aria-busy", "true");
        builder.AddAttribute(4, "aria-label", "Loading incident…");

        builder.OpenElement(5, "span");
        builder.AddAttribute(6, "class", "aot-skel");
        builder.AddAttribute(7, "style", "width:180px;height:20px");
        builder.CloseElement();

        builder.OpenElement(8, "span");
        builder.AddAttribute(9, "class", "aot-skel");
        builder.AddAttribute(10, "style", "width:90%;height:18px;margin-top:16px");
        builder.CloseElement();

        builder.OpenElement(11, "span");
        builder.AddAttribute(12, "class", "aot-skel");
        builder.AddAttribute(13, "style", "width:60%");
        builder.CloseElement();

        builder.OpenElement(14, "span");
        builder.AddAttribute(15, "class", "aot-skel");
        builder.AddAttribute(16, "style", "width:40%");
        builder.CloseElement();

        builder.CloseElement();
    };

    private string EffectiveLang => string.IsNullOrWhiteSpace(Incident.Lang) ? "fi" : Incident.Lang;

    private long? FirstInsertingRevId
    {
        get
        {
            if (Incident.Source.InsertingRevIds is { Count: > 0 } revIds && revIds[0] > 0)
            {
                return revIds[0];
            }

            var firstEdit = Incident.Edits.FirstOrDefault(static e => e.Action is EditAction.Inserted or EditAction.Reinserted);
            return firstEdit is { RevId: > 0 } ? firstEdit.RevId : null;
        }
    }

    private string Href
    {
        get
        {
            var slug = TopicSlug.From(Topic);
            var effectiveTopic = slug.Length > 0 ? slug : Topic;
            var normalizedQuery = string.IsNullOrEmpty(Query)
                ? ""
                : Query.StartsWith('?') ? Query : "?" + Query;
            return $"/investigate/{Uri.EscapeDataString(effectiveTopic)}/incidents/{Uri.EscapeDataString(Incident.Id)}{normalizedQuery}";
        }
    }

    private Task HandleMouseEnterAsync() =>
        OnHover.HasDelegate ? OnHover.InvokeAsync(Incident.Id) : Task.CompletedTask;

    private Task HandleMouseLeaveAsync() =>
        OnHover.HasDelegate ? OnHover.InvokeAsync(null) : Task.CompletedTask;

    private static bool HasDistinctEnglishTitle(ArticleRef article) =>
        !string.IsNullOrWhiteSpace(article.TitleEn)
        && !string.Equals(article.TitleEn, article.TitleFi, StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTimeOffset timestamp) =>
        timestamp.UtcDateTime.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
}

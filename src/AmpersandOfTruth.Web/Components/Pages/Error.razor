@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Ampersand of Truth</PageTitle>

<div class="aot-stack" style="max-width:640px" data-testid="error-page">
    <h1 class="aot-h1">Something went wrong loading this page.</h1>
    <p class="aot-muted" style="margin:0">Please try again in a moment, or return to topic search.</p>
    <div>
        <a class="aot-btn" href="/" data-testid="error-home">Back to topic search</a>
    </div>
    @if (ShowRequestId)
    {
        <p class="aot-small aot-muted" style="margin:0" data-testid="error-request-id">
            Request ID: <code class="aot-num">@RequestId</code>
        </p>
    }
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

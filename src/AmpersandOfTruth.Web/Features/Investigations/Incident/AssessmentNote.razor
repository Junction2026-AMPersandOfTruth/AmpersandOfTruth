@using AmpersandOfTruth.Web.Features.Evidence
@using AmpersandOfTruth.Web.Features.Investigations.View

<section class="aot-assess" data-testid="assessment">
    <div class="aot-label">@Attribution.AutomatedAssessmentLabel</div>
    @if (Assessment is null)
    {
        <p class="aot-small aot-muted" style="margin:8px 0 0">Assessment unavailable. The automated assessment could not be run for this incident. The removal history above still stands.</p>
    }
    else
    {
        var (steps, word) = MapConfidence(Assessment.Confidence);
        var quotes = Assessment.Quotes.Where(static q => !string.IsNullOrWhiteSpace(q)).ToList();
        <p style="margin:8px 0 0"><b>Category:</b> @MapCategory(Assessment.Category)</p>
        @if (!string.IsNullOrWhiteSpace(Assessment.Reasoning))
        {
            <p class="aot-assess__reasoning">@Assessment.Reasoning</p>
        }
        @if (quotes.Count > 0)
        {
            <blockquote class="aot-assess__quotes" data-testid="assessment-quotes">
                @foreach (var quote in quotes)
                {
                    <div class="aot-assess__quote"><q class="aot-ev" data-testid="assessment-quote">@quote</q></div>
                }
            </blockquote>
        }
        <div class="aot-small aot-assess__confidence" data-testid="assessment-confidence">
            <span>Confidence</span>
            <span class="aot-meter" aria-label="@word">@for (var i = 1; i <= 3; i++) { <i class="@(i <= steps ? "on" : null)"></i> }</span>
            <span>@word</span>
        </div>
        <p class="aot-small aot-muted" style="margin:8px 0 0">@FormatUncertainty(Assessment.Uncertainty)</p>
    }
</section>

@code {
    [Parameter] public AssessmentView? Assessment { get; set; }

    private static string MapCategory(ContentCategory category) => category switch
    {
        ContentCategory.ContentDispute => "a content dispute",
        ContentCategory.PovPush => "one-sided wording",
        ContentCategory.FalseFactualClaim => "a false factual claim",
        ContentCategory.SourceManipulation => "a change of sources",
        ContentCategory.GoodFaithError => "a good-faith error",
        _ => "other",
    };

    private static (int Steps, string Word) MapConfidence(int confidence) => confidence switch
    {
        <= 2 => (1, "low"),
        3 => (2, "medium"),
        _ => (3, "high"),
    };

    private static string FormatUncertainty(string? uncertainty)
    {
        if (string.IsNullOrWhiteSpace(uncertainty))
        {
            return "Uncertainty: automated from the diff above; it can be wrong.";
        }

        var trimmed = uncertainty.Trim();
        return trimmed.StartsWith("Uncertainty:", StringComparison.OrdinalIgnoreCase)
            ? trimmed
            : $"Uncertainty: {trimmed}";
    }
}

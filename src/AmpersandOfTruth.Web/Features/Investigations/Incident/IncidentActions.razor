@using AmpersandOfTruth.Web.Features.Annotations
@using AmpersandOfTruth.Web.Features.Library
@using Microsoft.Extensions.DependencyInjection
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<IncidentActions> Logger
@inject IServiceProvider Services

<section class="aot-panel" data-testid="incident-actions">
    <div class="aot-row">
        <button type="button" class="aot-btn aot-btn--sm" data-testid="copy-link" @onclick="CopyLinkAsync">
            @(_copied ? "Copied" : "Copy link")
        </button>
        <button type="button"
                class="aot-btn aot-btn--ghost aot-btn--sm"
                data-testid="looks-wrong"
                aria-expanded="@(_showFeedback ? "true" : "false")"
                @onclick="ToggleFeedback">
            This looks wrong
        </button>
    </div>

    @if (_submitted)
    {
        <p class="aot-small aot-muted" style="margin:8px 0 0" role="status" data-testid="looks-wrong-thanks">Thanks — noted.</p>
    }
    else if (_showFeedback)
    {
        <div class="aot-stack" style="margin-top:8px;gap:8px" @onkeydown:stopPropagation>
            <label class="aot-small aot-muted" for="looks-wrong-note">What looks wrong about this incident?</label>
            <textarea id="looks-wrong-note"
                      class="form-control"
                      rows="3"
                      value="@_note"
                      @oninput="HandleNoteInput"
                      @onchange="HandleNoteInput"
                      data-testid="looks-wrong-input"></textarea>
            <div class="aot-row">
                <button type="button" class="aot-btn aot-btn--primary aot-btn--sm" data-testid="looks-wrong-send" @onclick="SendFeedbackAsync">Send</button>
            </div>
        </div>
    }
</section>

@code {
    private (string Topic, string IncidentId, Guid? SavedId) _key;
    private bool _copied;
    private bool _showFeedback;
    private bool _submitted;
    private string _note = "";

    [Parameter] public string Topic { get; set; } = "";
    [Parameter] public string IncidentId { get; set; } = "";
    [Parameter] public Guid? SavedId { get; set; }
    [Parameter] public EventCallback OnAnnotationSaved { get; set; }

    private Guid? EffectiveSavedId => SavedId ?? TryReadSavedFromUri(Navigation.Uri);

    protected override void OnParametersSet()
    {
        var current = (Topic, IncidentId, EffectiveSavedId);
        if (_key != current)
        {
            _key = current;
            _copied = false;
            _showFeedback = false;
            _submitted = false;
            _note = "";
        }
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri);
            _copied = true;
        }
        catch
        {
            // Clipboard API may be unavailable during prerender, insecure context, or disconnected circuit.
        }
    }

    private void ToggleFeedback()
    {
        _submitted = false;
        _showFeedback = !_showFeedback;
    }

    private void HandleNoteInput(ChangeEventArgs e) =>
        _note = e.Value?.ToString() ?? "";

    private async Task SendFeedbackAsync()
    {
        var trimmed = _note.Trim();

        Logger.LogInformation(
            "Incident feedback noted for {Topic}/{IncidentId}: {FeedbackNote}",
            Topic,
            IncidentId,
            trimmed);

        if (EffectiveSavedId is { } savedId
            && !string.IsNullOrWhiteSpace(IncidentId)
            && Services.GetService<AnnotationStore>() is { } store
            && Services.GetService<OwnerKey>() is { } ownerKey)
        {
            var owner = await ownerKey.GetOrCreateAsync();
            var existingMap = await store.ForInvestigationAsync(savedId);
            existingMap.TryGetValue(IncidentId, out var existing);

            var saved = await store.UpsertAsync(
                savedId,
                owner,
                IncidentId,
                verdict: existing?.Verdict,
                dismiss: existing?.DismissReason,
                note: trimmed,
                source: "looks_wrong");

            if (saved && OnAnnotationSaved.HasDelegate)
            {
                await OnAnnotationSaved.InvokeAsync();
            }
        }

        _submitted = true;
        _showFeedback = false;
    }

    private static Guid? TryReadSavedFromUri(string? rawUri)
    {
        if (!Uri.TryCreate(rawUri, UriKind.Absolute, out var uri) || string.IsNullOrEmpty(uri.Query))
        {
            return null;
        }

        foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0)
            {
                continue;
            }

            var name = Uri.UnescapeDataString(part[..eq]);
            if (string.Equals(name, "saved", StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(Uri.UnescapeDataString(part[(eq + 1)..]), out var parsed))
            {
                return parsed;
            }
        }

        return null;
    }
}

@using System.Globalization
@using AmpersandOfTruth.Web.Features.Evidence
@using AmpersandOfTruth.Web.Features.Investigations.Pipeline

<details class="aot-collapsed" data-testid="unflagged-toggle" open="@Open">
    <summary>Removed edits we did not flag (@Items.Count.ToString("N0", CultureInfo.InvariantCulture)) — routine cleanup, formatting, vandalism</summary>
    @if (Items.Count > 0)
    {
        <div style="overflow-x:auto;margin-top:12px">
            <table class="aot-wikitable" style="width:100%">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Article (Finnish Wikipedia)</th>
                        <th>Account</th>
                        <th>Removal summary (Finnish)</th>
                        <th>On Wikipedia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items)
                    {
                        var maskedSummary = EditorDisplay.MaskComment(item.Revert.Comment);
                        var reason = ResolveReason(item);
                        <tr data-testid="unflagged-row">
                            <td class="aot-num" style="white-space:nowrap">@FormatDate(item.Revert.Timestamp)</td>
                            <td><a href="/articles/@item.Article.PageId" lang="fi">@item.Article.Title</a></td>
                            <td><EditorTag User="@item.Revert.RevertedUser" /></td>
                            <td>
                                @if (reason is not null)
                                {
                                    <span class="aot-chip aot-muted"
                                          style="@(!string.IsNullOrWhiteSpace(maskedSummary) ? "margin-right:6px" : null)"
                                          data-testid="unflagged-reason">@reason</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(maskedSummary))
                                {
                                    <span lang="fi">@maskedSummary</span>
                                }
                                else if (reason is null)
                                {
                                    <span class="aot-muted">—</span>
                                }
                            </td>
                            <td style="white-space:nowrap">
                                <a href="@item.Revert.RevertedDiffUrl.AbsoluteUri" target="_blank" rel="noopener">View change ↗</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="aot-small aot-muted" style="margin:8px 0 0">Article titles and edit summaries above are shown in their original Finnish from Wikipedia.</p>
        </div>
    }
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RemovedEdit> Items { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<(long PageId, long RevertingRevId), string>? Classes { get; set; }
    [Parameter] public bool Open { get; set; }

    private string? ResolveReason(RemovedEdit item)
    {
        if (Classes is null)
        {
            return null;
        }

        if (Classes.TryGetValue((item.Revert.PageId, item.Revert.RevId), out var cls) ||
            Classes.TryGetValue((item.Article.PageId, item.Revert.RevId), out cls))
        {
            return ContestSignals.FormatRevertClass(cls);
        }

        return null;
    }

    private static string FormatDate(DateTime timestamp) =>
        DateTime.SpecifyKind(timestamp, DateTimeKind.Utc).ToString("d MMM yyyy", CultureInfo.InvariantCulture);
}

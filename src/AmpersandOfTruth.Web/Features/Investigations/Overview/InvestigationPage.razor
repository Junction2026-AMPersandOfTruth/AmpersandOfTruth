    {
        if (string.Equals(_hotId, id, StringComparison.Ordinal)) return;
        _hotId = id;
        StateHasChanged();
    }

    private async Task HandleMarkClickAsync(string incidentId)
    {
        _hotId = incidentId;
        var js = Services.GetService<IJSRuntime>();
        if (js is null) return;

        try
        {
            var element = await js.InvokeAsync<IJSObjectReference?>(
                "document.getElementById",
                $"incident-{incidentId}");
            if (element is not null)
            {
                await element.InvokeVoidAsync("scrollIntoView", new { behavior = "smooth", block = "nearest" });
                await element.DisposeAsync();
            }
        }
        catch
        {
            // Ignore when running headless or if element is filtered out.
        }
    }

    private async Task CopyLinkAsync()
    {
        var js = Services.GetService<IJSRuntime>();
        if (js is null) return;

        try
        {
            await js.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri);
            _copied = true;
        }
        catch
        {
            // Ignore clipboard errors in unsupported contexts.
        }
    }

    private IReadOnlyList<SignalPhrase> BuildSignalOptions()
    {
        var counted = OverviewState.SignalCounts(_incidents);
        var result = new List<SignalPhrase>(counted.Count + _filter.Signals.Count);
        var seen = new HashSet<string>(StringComparer.Ordinal);

        foreach (var (phrase, _) in counted)
        {
            if (seen.Add(phrase.Id))
            {
                result.Add(phrase);
            }
        }

        foreach (var selected in _filter.Signals.Order(StringComparer.Ordinal))
        {
            var canonical = SignalCatalog.Normalize(selected);
            if (seen.Add(canonical))
            {
                result.Add(SignalCatalog.For(canonical));
            }
        }

        return result;
    }

    private string? TryGetTitleEn(long pageId) =>
        _articleTitlesEn.GetValueOrDefault(pageId);

    private ArticleAggregates? TryGetTimeline(long pageId) =>
        _sparklines.GetValueOrDefault(pageId);

    private PageContest? TryGetContest(long pageId) =>
        _pageContests.GetValueOrDefault(pageId);

    private int CountIncidentsForArticle(long pageId) =>
        _incidents.Count(i => i.Articles.Any(a => a.PageId == pageId));

    private string ResolveArticleLabel(long pageId)
    {
        if (_articleTitlesEn.TryGetValue(pageId, out var en) && !string.IsNullOrWhiteSpace(en))
        {
            return en;
        }

        var fromRail = _progress.Articles.FirstOrDefault(a => a.PageId == pageId);
        if (fromRail is not null)
        {
            return fromRail.Title;
        }

        return pageId.ToString(CultureInfo.InvariantCulture);
    }

    private static string FormatSortValue(IncidentSort sort) => sort switch
    {
        IncidentSort.Recent => "recent",
        IncidentSort.LongestLive => "longest-live",
        _ => "relevance",
    };

    private void HandleSaved(Guid id)
    {
        _activeSavedId = id;
        _completedAnalysedAt ??= Time.GetUtcNow();
    }

    private async Task TryAutosaveSnapshotAsync(
        Guid savedId,
        IReadOnlyList<IncidentRecord> incidents,
        DateTimeOffset analysedAt,
        CancellationToken ct)
    {
        var store = Services.GetService<LibraryStore>();
        var ownerKey = Services.GetService<OwnerKey>();
        if (store is null || ownerKey is null) return;

        var owner = await ownerKey.GetOrCreateAsync(ct);
        var snapshot = new SavedSnapshot(TopicText, _progress.Articles, incidents, analysedAt);
        await store.UpdateSnapshotAsync(savedId, owner, snapshot, ct);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed || !_hasRendered) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            var nextSaved = EffectiveSavedId;
            if (nextSaved != _activeSavedId)
            {
                _activeSavedId = nextSaved;
                _ = StartRunAsync();
            }
            else
            {
                StateHasChanged();
            }
        });
    }

    private static Guid? TryParseSavedFromUri(string uri)
    {
        if (!Uri.TryCreate(uri, UriKind.Absolute, out var abs) || string.IsNullOrEmpty(abs.Query))
        {
            return null;
        }

        var query = QueryHelpers.ParseQuery(abs.Query);
        return query.TryGetValue("saved", out var raw) && Guid.TryParse(raw.ToString(), out var id)
            ? id
            : null;
    }

    private void CancelCurrentRunTokens()
    {
        StopSlowMonitor();
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }

    public void Dispose()
    {
        _disposed = true;
        Nav.LocationChanged -= HandleLocationChanged;
        CancelCurrentRunTokens();
        if (_jsModule is { } jsModule)
        {
            _jsModule = null;
            _ = DisposeJsModuleAsync(jsModule);
        }
    }

    private static async Task DisposeJsModuleAsync(IJSObjectReference jsModule)
    {
        try
        {
            await jsModule.DisposeAsync();
        }
        catch
        {
            // Ignore disconnected circuit disposal errors.
        }
    }

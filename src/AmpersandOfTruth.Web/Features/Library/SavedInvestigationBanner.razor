@using System.Globalization

<div class="aot-banner aot-banner--info" role="status" data-testid="saved-banner">
    <div class="aot-banner__body">
        Saved investigation · analysed @FormatDate(AnalysedAt)
    </div>
    <button type="button"
            class="aot-btn aot-btn--sm"
            data-testid="rerun-latest"
            disabled="@Running"
            @onclick="OnRerunLatest">
        Re-run latest
    </button>
</div>

@code {
    [Parameter, EditorRequired] public DateTimeOffset AnalysedAt { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter] public EventCallback OnRerunLatest { get; set; }

    private static string FormatDate(DateTimeOffset date) =>
        date.UtcDateTime.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
}

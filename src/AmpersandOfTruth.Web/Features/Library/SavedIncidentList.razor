@using System.Globalization
@using AmpersandOfTruth.Web.Features.Annotations
@using AmpersandOfTruth.Web.Features.Investigations.View
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@{
    var dismissed = Incidents.Where(i => IsDismissed(i.Id)).ToList();
    var active = Incidents.Where(i => !IsDismissed(i.Id)).ToList();
    var pinned = active.Where(i => _pinnedIds.Contains(i.Id)).ToList();
    var unpinned = active.Where(i => !_pinnedIds.Contains(i.Id)).ToList();
}

@if (pinned.Count > 0)
{
    <div class="aot-stack" style="gap:16px" data-testid="pinned-list">
        <div class="aot-label">Pinned (@pinned.Count)</div>
        @foreach (var incident in pinned)
        {
            <div class="aot-stack" style="gap:4px" @key="@($"pin-{incident.Id}")">
                <div class="aot-row" style="justify-content:space-between">
                    <div class="aot-row">
                        @if (TryGetAnnotation(incident.Id) is { Verdict: { } verdict } ann)
                        {
                            <VerdictChip Verdict="verdict" DismissReason="ann.DismissReason" Note="@ann.Note" />
                        }
                    </div>
                    <button type="button"
                            class="aot-chip"
                            aria-pressed="true"
                            data-testid="pin-incident"
                            data-incident="@incident.Id"
                            @onclick="@(() => TogglePinAsync(incident.Id))">
                        Pinned
                    </button>
                </div>
                <IncidentCard Incident="incident"
                              Topic="@Topic"
                              Query="@EffectiveQuery"
                              Highlighted="@string.Equals(HotId, incident.Id, StringComparison.Ordinal)"
                              OnHover="OnHover" />
            </div>
        }
    </div>
}

@foreach (var incident in unpinned)
{
    <div class="aot-stack" style="gap:4px" @key="incident.Id">
        <div class="aot-row" style="justify-content:space-between">
            <div class="aot-row">
                @if (TryGetAnnotation(incident.Id) is { Verdict: { } verdict } ann)
                {
                    <VerdictChip Verdict="verdict" DismissReason="ann.DismissReason" Note="@ann.Note" />
                }
            </div>
            <button type="button"
                    class="aot-chip"
                    aria-pressed="false"
                    data-testid="pin-incident"
                    data-incident="@incident.Id"
                    @onclick="@(() => TogglePinAsync(incident.Id))">
                Pin
            </button>
        </div>
        <IncidentCard Incident="incident"
                      Topic="@Topic"
                      Query="@EffectiveQuery"
                      Highlighted="@string.Equals(HotId, incident.Id, StringComparison.Ordinal)"
                      OnHover="OnHover" />
    </div>
}

@if (dismissed.Count > 0)
{
    <details class="aot-collapsed" data-testid="dismissed-group">
        <summary>Dismissed (@dismissed.Count.ToString("N0", CultureInfo.InvariantCulture))</summary>
        <div class="aot-stack" style="gap:16px;margin-top:12px">
            @foreach (var incident in dismissed)
            {
                var isPinned = _pinnedIds.Contains(incident.Id);
                <div class="aot-stack" style="gap:4px" @key="@($"dis-{incident.Id}")">
                    <div class="aot-row" style="justify-content:space-between">
                        <div class="aot-row">
                            @if (TryGetAnnotation(incident.Id) is { Verdict: { } verdict } ann)
                            {
                                <VerdictChip Verdict="verdict" DismissReason="ann.DismissReason" Note="@ann.Note" />
                            }
                        </div>
                        <button type="button"
                                class="aot-chip"
                                aria-pressed="@(isPinned ? "true" : "false")"
                                data-testid="pin-incident"
                                data-incident="@incident.Id"
                                @onclick="@(() => TogglePinAsync(incident.Id))">
                            @(isPinned ? "Pinned" : "Pin")
                        </button>
                    </div>
                    <IncidentCard Incident="incident"
                                  Topic="@Topic"
                                  Query="@EffectiveQuery"
                                  Highlighted="@string.Equals(HotId, incident.Id, StringComparison.Ordinal)"
                                  OnHover="OnHover" />
                </div>
            }
        </div>
    </details>
}

@code {
    private Guid? _loadedSavedId;
    private string? _lastHotId;
    private HashSet<string> _pinnedIds = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, IncidentAnnotation> _annotations =
        new Dictionary<string, IncidentAnnotation>(StringComparer.Ordinal);

    [Parameter, EditorRequired] public Guid SavedId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<IncidentView> Incidents { get; set; } = [];
    [Parameter, EditorRequired] public string Topic { get; set; } = "";
    [Parameter] public string? Query { get; set; }
    [Parameter] public string? HotId { get; set; }
    [Parameter] public EventCallback<string?> OnHover { get; set; }

    private string EffectiveQuery
    {
        get
        {
            var raw = string.IsNullOrWhiteSpace(Query) ? "" : Query.TrimStart('?');
            if (string.IsNullOrEmpty(raw))
            {
                return $"?saved={SavedId}";
            }

            foreach (var part in raw.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = part.IndexOf('=');
                var name = eq >= 0 ? part[..eq] : part;
                if (string.Equals(Uri.UnescapeDataString(name), "saved", StringComparison.OrdinalIgnoreCase))
                {
                    return "?" + raw;
                }
            }

            return $"?saved={SavedId}&{raw}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedSavedId == SavedId && _lastHotId != HotId)
        {
            _lastHotId = HotId;
            return;
        }

        _loadedSavedId = SavedId;
        _lastHotId = HotId;
        await ReloadAsync();
    }

    private IncidentAnnotation? TryGetAnnotation(string incidentId) =>
        _annotations.TryGetValue(incidentId, out var ann) ? ann : null;

    private bool IsDismissed(string incidentId) =>
        AnnotationLabels.IsDismissed(TryGetAnnotation(incidentId));

    private async Task ReloadAsync()
    {
        await ReloadPinsAsync();
        await ReloadAnnotationsAsync();
    }

    private async Task ReloadPinsAsync()
    {
        var store = Services.GetService<LibraryStore>();
        if (store is null)
        {
            _pinnedIds = new HashSet<string>(StringComparer.Ordinal);
            return;
        }

        var pins = await store.PinsAsync(SavedId);
        _pinnedIds = pins.Select(static p => p.IncidentId).ToHashSet(StringComparer.Ordinal);
    }

    private async Task ReloadAnnotationsAsync()
    {
        var store = Services.GetService<AnnotationStore>();
        if (store is null)
        {
            _annotations = new Dictionary<string, IncidentAnnotation>(StringComparer.Ordinal);
            return;
        }

        _annotations = await store.ForInvestigationAsync(SavedId);
    }

    private async Task TogglePinAsync(string incidentId)
    {
        var store = Services.GetService<LibraryStore>();
        var ownerKey = Services.GetService<OwnerKey>();
        if (store is null || ownerKey is null)
        {
            return;
        }

        var owner = await ownerKey.GetOrCreateAsync();
        if (_pinnedIds.Contains(incidentId))
        {
            await store.UnpinAsync(SavedId, owner, incidentId);
        }
        else
        {
            await store.PinAsync(SavedId, owner, incidentId, note: null);
        }

        await ReloadPinsAsync();
    }
}

@* P3.3 (#56): the web-request counter on the usage page (/analysis, linked from the footer as "Assessment usage";
   hidden in demo safe mode). Updates live from the WebSpreadCalls ledger while a trace runs. *@
@implements IDisposable
@using System.Globalization
@using AmpersandOfTruth.Web.Features.WebSpread.Store
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@inject IServiceProvider Services

@if (_store is not null && _options is not null)
{
    var opt = _options.CurrentValue;
    var pct = opt.DailyRequestCap > 0 ? Math.Min(100.0, 100.0 * _usage.LiveToday / opt.DailyRequestCap) : 0;
    <section class="mb-4" data-testid="web-usage">
        <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
            <h2 class="h5 mb-0">Web requests today (UTC)</h2>
            <span class="text-muted small">
                @if (opt.EffectiveMode == OxylabsMode.None)
                {
                    <text>Web search is not configured on this deployment</text>
                }
                else
                {
                    @string.Create(CultureInfo.InvariantCulture, $"Per-incident cap: {opt.PerScopeRequestCap:N0} live requests")
                }
            </span>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Live requests (Oxylabs)</div>
                        <div class="fs-4 fw-semibold" data-testid="web-usage-live">
                            @string.Create(CultureInfo.InvariantCulture, $"{_usage.LiveToday:N0} / {opt.DailyRequestCap:N0}")
                        </div>
                        <div class="progress mt-2" style="height: 6px;" role="progressbar" aria-label="Daily web request usage"
                             aria-valuenow="@pct.ToString("0", CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(pct >= 100 ? "bg-danger" : "")"
                                 style="@($"width: {pct.ToString("0.#", CultureInfo.InvariantCulture)}%")"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">Served from cache</div>
                        <div class="fs-4 fw-semibold" data-testid="web-usage-cache">@_usage.CacheHitsToday.ToString("N0", CultureInfo.InvariantCulture)</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    private WebSpreadStore? _store;
    private IOptionsMonitor<OxylabsOptions>? _options;
    private WebUsage _usage = new(0, 0, 0);
    private bool _loading, _reloadPending, _disposed;

    protected override async Task OnInitializedAsync()
    {
        _store = Services.GetService<WebSpreadStore>();
        _options = Services.GetService<IOptionsMonitor<OxylabsOptions>>();
        if (_store is null)
        {
            return;
        }
        _store.Changed += OnChanged;
        await RefreshAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        if (_disposed)
        {
            return;
        }
        await RefreshAsync();
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    private async Task RefreshAsync()
    {
        if (_store is null)
        {
            return;
        }
        if (_loading)
        {
            _reloadPending = true; // a trace writes ~30 ledger rows; coalesce instead of queueing a query per row
            return;
        }
        _loading = true;
        try
        {
            do
            {
                _reloadPending = false;
                _usage = await _store.UsageAsync();
            }
            while (_reloadPending && !_disposed);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // the counter is informational: a failed read keeps the last numbers
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_store is not null)
        {
            _store.Changed -= OnChanged;
        }
    }
}

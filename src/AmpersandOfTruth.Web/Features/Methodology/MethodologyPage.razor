@page "/methodology"
@using AmpersandOfTruth.Web.Features.Evidence

<PageTitle>How this works · Ampersand of Truth</PageTitle>

<div class="aot-page aot-stack methodology-page" data-testid="methodology-page">
    <header>
        <h1 class="aot-h1">How this works</h1>
    </header>

    <section class="methodology-section aot-stack" data-testid="methodology-section" data-section="how" aria-labelledby="how">
        <h2 id="how" class="aot-h2">How findings are made</h2>
        <p>@Methodology.Summary</p>
        <PipelineDiagram />
    </section>

    <section class="methodology-section aot-stack" data-testid="methodology-section" data-section="levels" aria-labelledby="levels">
        <h2 id="levels" class="aot-h2">Evidence levels</h2>
        <p>
            Every finding has one of three levels. Higher levels only add evidence: each level requires everything in the level below it,
            and when in doubt a finding stays at the lower level.
        </p>

        <div class="methodology-levels aot-stack">
            @foreach (var level in Levels)
            {
                <article class="aot-panel methodology-level" data-testid="methodology-level" data-level="@level.Info.Level">
                    <div class="aot-row methodology-level__head">
                        <span class="aot-label">Level @level.Info.Level</span>
                        <TierBadge Tier="level.Info.Tier" />
                    </div>
                    <p class="methodology-level__meaning">@level.Info.Meaning</p>
                    <h3 class="aot-h3">What it takes</h3>
                    <ul class="methodology-list">
                        @foreach (var requirement in level.Requirements)
                        {
                            <li>@requirement</li>
                        }
                    </ul>
                </article>
            }
        </div>

        <p class="aot-small aot-muted methodology-note">
            <strong>Left out altogether:</strong> edits that only change markup, whitespace, categories, links or templates;
            removals by the same account that added the text; bot edits; blanked pages or sections; content that Wikipedia editors
            kept in the latest revision; and edits classed with confidence as obvious vandalism or test edits.
        </p>
    </section>

    <section class="methodology-section aot-stack" data-testid="methodology-section" data-section="quality" aria-labelledby="quality">
        <h2 id="quality" class="aot-h2">Measured quality</h2>
        <p>
            <strong>Being measured.</strong> Precision numbers from our hand-checked evaluation set will appear here after the evaluation.
        </p>
    </section>

    <section class="methodology-section aot-stack" data-testid="methodology-section" data-section="coverage" aria-labelledby="coverage">
        <h2 id="coverage" class="aot-h2">Coverage</h2>
        <dl class="aot-facts methodology-facts">
            <div>
                <dt>Articles</dt>
                <dd><span class="aot-num">19,742</span> Finnish Wikipedia articles</dd>
            </div>
            <div>
                <dt>Category scope</dt>
                <dd>History of Finland category tree</dd>
            </div>
            <div>
                <dt>Edit history</dt>
                <dd><span class="aot-num">2003 – 1 Oct 2026</span> (UTC)</dd>
            </div>
            <div>
                <dt>Language edition</dt>
                <dd>Finnish only (<code>fi.wikipedia.org</code>)</dd>
            </div>
        </dl>
        <p>
            You can search for a topic in any language, and findings display machine translations into English alongside the original Finnish text,
            but all analysed edits come from the 19,742 Finnish Wikipedia articles in the History of Finland category tree between 2003 and 1 Oct 2026.
        </p>
    </section>

    <section class="methodology-section aot-stack" data-testid="methodology-section" data-section="limitations" aria-labelledby="limitations">
        <h2 id="limitations" class="aot-h2">Limitations</h2>
        <ul class="methodology-list">
            @foreach (var limitation in Methodology.Limitations)
            {
                <li data-testid="methodology-limitation">@limitation</li>
            }
        </ul>
    </section>

    <section class="methodology-section aot-stack" data-testid="methodology-section" data-section="attribution" aria-labelledby="attribution">
        <h2 id="attribution" class="aot-h2">Attribution and licences</h2>
        <p>@Attribution.FooterText</p>
        <p>
            @Attribution.MachineTranslationNotice
            Licence:
            <a class="aot-ext" href="@Attribution.LicenseUrl.AbsoluteUri" target="_blank" rel="noopener" data-testid="license-link">@Attribution.License</a>.
        </p>
        <h3 class="aot-h3">Datasets and embeddings</h3>
        <ul class="methodology-list">
            <li><strong>Wikimedia dumps</strong> — revision history of Finnish Wikipedia (<code>fi.wikipedia.org</code>), licensed under @Attribution.License.</li>
            <li><strong>FineWiki</strong> — cleaned Wikipedia article prose.</li>
            <li><strong>MariaDB Foundation datasets</strong> — structured Wikipedia corpus tables and <code>bge-m3</code> article embeddings.</li>
        </ul>
    </section>
</div>

@code {
    private sealed record LevelEntry(EvidenceTierInfo Info, IReadOnlyList<string> Requirements);

    private static readonly IReadOnlyList<LevelEntry> Levels =
    [
        new(
            EvidenceTiers.Reverted,
            [
                "An edit added substantive content — prose, a number, a date, a name, or a source — rather than only markup, links, categories or templates.",
                "A different editor later took that content out, and it is no longer in the latest revision of the article.",
                "The edit was not made by a bot, did not blank a page or section, and was not classed with confidence as obvious vandalism or a test edit.",
                "Findings also stay at Level 1 whenever an automated assessment is unavailable, uncertain, or reads the edit as a good-faith mistake.",
            ]),
        new(
            EvidenceTiers.Contested,
            [
                "Everything required for Level 1.",
                "Automated assessment reads the added text with confidence of at least 3 out of 5 as a factual claim, a point-of-view push, a content dispute, or source manipulation, quoting exact words from the edit.",
                "Wikipedia editors disputed it in at least one observable way: the removal summary raised accuracy, neutrality or sourcing; the content was put back at least once after removal; editors went back and forth over the passage; or an editor added a dispute notice to the article in the same episode.",
                "Neither the automated assessment nor edit-history signals can reach Level 2 on their own — both must agree.",
            ]),
        new(
            EvidenceTiers.Campaign,
            [
                "Everything required for Level 2.",
                "At least 2 of 4 coordination signals, including at least one across editors or across articles:",
                "Multiple editors: the same claim was added by at least 2 distinct editors (anonymous edits from the same masked IP range count as one editor).",
                "Multiple articles: the same claim was added to at least 2 articles.",
                "Persistence: the claim was put back at least 2 times, with at least 7 days between its first and last insertion.",
                "Sources: a cited source was removed, replaced, or made up alongside the claim.",
                "A single account editing one article, no matter how many times, stays at Level 2.",
            ]),
    ];
}

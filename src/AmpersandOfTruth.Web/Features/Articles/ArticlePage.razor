@page "/articles/{PageId:long}"
@implements IDisposable
@using System.Globalization
@using AmpersandOfTruth.Web.Features.Evidence
@using AmpersandOfTruth.Web.Features.Investigations
@inject ArticleTimelineService TimelineService
@inject NavigationManager Nav

<PageTitle>@(_aggregates is not null ? $"{_aggregates.TitleFi} · Ampersand of Truth" : "Article · Ampersand of Truth")</PageTitle>

<div class="aot-page aot-stack">
    @if (_loading)
    {
        <div class="aot-stack" data-testid="article-loading" role="status" aria-label="Loading article history">
            <div class="aot-skel" style="width:280px;height:28px"></div>
            <div class="aot-skel" style="width:180px;height:14px"></div>
            <svg class="aot-chart" viewBox="0 0 900 180" width="100%" aria-hidden="true">
                @for (var i = 0; i < 36; i++)
                {
                    var x = 36 + (i * 23.5);
                    var h = 24 + ((i * 37) % 96);
                    var y = 148 - h;
                    <rect x="@x.ToString("0.#", CultureInfo.InvariantCulture)"
                          y="@y.ToString("0.#", CultureInfo.InvariantCulture)"
                          width="18"
                          height="@h.ToString(CultureInfo.InvariantCulture)"
                          style="fill:var(--surface-sunken,#e9ecef)" />
                }
            </svg>
        </div>
    }
    else if (_hasError)
    {
        <div class="aot-banner aot-banner--error" role="alert" data-testid="article-error">
            <svg viewBox="0 0 18 18" aria-hidden="true">
                <circle cx="9" cy="9" r="7" />
                <path d="M9 5v5M9 12.5v.5" />
            </svg>
            <div class="aot-banner__body">
                <b>The Wikipedia data is not reachable right now.</b>
                @if (!string.IsNullOrWhiteSpace(_errorDetail))
                {
                    <details>
                        <summary>Technical detail</summary>
                        <pre>@_errorDetail</pre>
                    </details>
                }
            </div>
            <button type="button" class="aot-btn aot-btn--sm" data-testid="article-retry" @onclick="RetryAsync">Retry</button>
        </div>
    }
    else if (_aggregates is null)
    {
        <EmptyState Message="We don't have this article." />
    }
    else
    {
        <header class="aot-stack" data-testid="article-header">
            <h1 class="aot-h1">
                @if (!string.IsNullOrWhiteSpace(_aggregates.TitleEn) &&
                     !string.Equals(_aggregates.TitleEn, _aggregates.TitleFi, StringComparison.Ordinal))
                {
                    <span>@_aggregates.TitleEn</span>
                    <span class="aot-muted aot-small" style="margin-left:8px">
                        FI <a href="@WikipediaLinks.Article(_aggregates.TitleFi).AbsoluteUri"
                              target="_blank"
                              rel="noopener"
                              lang="fi"
                              data-testid="wiki-article-link">@_aggregates.TitleFi ↗</a>
                    </span>
                }
                else
                {
                    <span lang="fi">@_aggregates.TitleFi</span>
                    <a href="@WikipediaLinks.Article(_aggregates.TitleFi).AbsoluteUri"
                       target="_blank"
                       rel="noopener"
                       class="aot-small"
                       style="margin-left:8px"
                       data-testid="wiki-article-link">fi.wikipedia ↗</a>
                }
            </h1>
            <div class="aot-row aot-small aot-muted">
                <span class="aot-num" data-testid="article-revision-count">@FormatHeaderCounts(_aggregates)</span>
            </div>
        </header>

        <section class="aot-stack" aria-label="Editing timeline">
            <ArticleTimeline Data="_aggregates"
                             Range="_selectedRange"
                             HighlightedIncidentId="@Incident"
                             OnRangeSelected="HandleRangeSelectedAsync" />
            <p class="aot-small" data-testid="timeline-summary">@ArticleTimelineService.Summary(_aggregates)</p>
        </section>

        @if (_selectedRange is not null)
        {
            <section class="aot-stack" aria-label="Revisions in selected period">
                <h2 class="aot-h2" data-testid="revisions-heading">Revisions @FormatRangeHeading(_selectedRange)</h2>

                @if (_revisionsLoading)
                {
                    <div class="aot-small aot-muted" role="status">Loading edits…</div>
                }
                else if (_revisions.Count == 0)
                {
                    <EmptyState Message="No edits in this range." />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="aot-wikitable w-100" data-testid="revisions-table">
                            <thead>
                                <tr>
                                    <th>Time (UTC)</th>
                                    <th>Editor</th>
                                    <th>Edit summary</th>
                                    <th>Size change</th>
                                    <th>Status</th>
                                    <th>Diff</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rev in _revisions)
                                {
                                    var editor = EditorDisplay.For(rev.User);
                                    var maskedComment = EditorDisplay.MaskComment(rev.Comment);
                                    <tr data-testid="revision-row" @key="rev.RevId">
                                        <td class="aot-num text-nowrap">@FormatTimestamp(rev.Ts)</td>
                                        <td data-testid="revision-editor">
                                            @if (editor.ProfileUrl is not null)
                                            {
                                                <a href="@editor.ProfileUrl.AbsoluteUri" target="_blank" rel="noopener">@editor.PlainText</a>
                                            }
                                            else
                                            {
                                                <span>@editor.PlainText</span>
                                            }
                                        </td>
                                        <td lang="fi" data-testid="revision-summary">@maskedComment</td>
                                        <td class="aot-num text-nowrap" data-testid="revision-delta">@FormatDeltaBytes(rev.DeltaBytes)</td>
                                        <td>
                                            @if (rev.WasRemoved)
                                            {
                                                <span class="aot-chip" data-testid="removed-badge">removed</span>
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            <a href="@WikipediaLinks.Diff(rev.RevId).AbsoluteUri"
                                               target="_blank"
                                               rel="noopener"
                                               data-testid="wiki-diff-link">diff ↗</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private CancellationTokenSource? _cts;
    private bool _interactive;
    private bool _loading = true;
    private bool _revisionsLoading;
    private bool _hasError;
    private string? _errorDetail;

    private long? _loadedPageId;
    private DateRange? _loadedRange;
    private ArticleAggregates? _aggregates;
    private DateRange? _selectedRange;
    private IReadOnlyList<ArticleRevision> _revisions = [];

    [Parameter]
    public long PageId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? To { get; set; }

    [SupplyParameterFromQuery(Name = "incident")]
    public string? Incident { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_interactive)
        {
            await SyncAsync(forceReload: false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            await SyncAsync(forceReload: true);
            StateHasChanged();
        }
    }

    private async Task SyncAsync(bool forceReload)
    {
        var pageChanged = forceReload || _loadedPageId != PageId;
        var queryRange = ResolveQueryRange();

        if (!pageChanged && _aggregates is not null)
        {
            var desiredRange = queryRange ?? _selectedRange ?? DefaultRange(_aggregates);
            if (_loadedRange == desiredRange)
            {
                return;
            }

            await LoadRevisionsOnlyAsync(desiredRange);
            return;
        }

        var ct = ResetCancellation();
        _loading = true;
        _hasError = false;
        _errorDetail = null;

        try
        {
            var aggregates = await TimelineService.AggregatesAsync(PageId, ct);
            _loadedPageId = PageId;
            _aggregates = aggregates;

            if (aggregates is null)
            {
                _selectedRange = null;
                _loadedRange = null;
                _revisions = [];
                return;
            }

            var initialRange = queryRange ?? DefaultRange(aggregates);
            _selectedRange = initialRange;
            _revisions = await TimelineService.RevisionsAsync(PageId, initialRange, limit: 500, ct: ct);
            _loadedRange = initialRange;
        }
        catch (CorpusUnavailableException ex)
        {
            _hasError = true;
            _errorDetail = ex.Message;
            _loadedPageId = null;
            _loadedRange = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
                _revisionsLoading = false;
            }
        }
    }

    private async Task LoadRevisionsOnlyAsync(DateRange range)
    {
        var ct = ResetCancellation();
        _selectedRange = range;
        _revisionsLoading = true;
        _hasError = false;
        _errorDetail = null;

        try
        {
            _revisions = await TimelineService.RevisionsAsync(PageId, range, limit: 500, ct: ct);
            _loadedRange = range;
        }
        catch (CorpusUnavailableException ex)
        {
            _hasError = true;
            _errorDetail = ex.Message;
            _loadedRange = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _revisionsLoading = false;
            }
        }
    }

    private async Task HandleRangeSelectedAsync(DateRange range)
    {
        await LoadRevisionsOnlyAsync(range);
        Nav.NavigateTo(BuildUri(range, Incident), replace: true);
    }

    private async Task RetryAsync()
    {
        await SyncAsync(forceReload: true);
    }

    private DateRange? ResolveQueryRange()
    {
        var fromStr = From;
        var toStr = To;

        if (string.IsNullOrWhiteSpace(fromStr) && string.IsNullOrWhiteSpace(toStr))
        {
            TryReadQueryFromUri(Nav.Uri, out fromStr, out toStr);
        }

        return TryParseRange(fromStr, toStr, out var parsed) ? parsed : null;
    }

    internal static DateRange DefaultRange(ArticleAggregates aggregates) =>
        ArticleTimelineService.MostContested(aggregates)?.Range
        ?? ArticleTimelineService.AllRange(aggregates);

    internal static bool TryParseRange(string? fromStr, string? toStr, out DateRange range)
    {
        range = default!;
        if (!TryParseMonthOrDate(fromStr, out var from) || !TryParseMonthOrDate(toStr, out var to))
        {
            return false;
        }

        if (to == from)
        {
            to = from.AddMonths(1);
        }

        if (to <= from)
        {
            return false;
        }

        range = new DateRange(from, to);
        return true;
    }

    private static bool TryParseMonthOrDate(string? raw, out DateTime utc)
    {
        utc = default;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        var trimmed = raw.Trim();
        if (DateTime.TryParseExact(
                trimmed,
                ["yyyy-MM", "yyyy-MM-dd"],
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
                out var parsed))
        {
            utc = DateTime.SpecifyKind(parsed, DateTimeKind.Utc);
            return true;
        }

        return false;
    }

    private static void TryReadQueryFromUri(string uriString, out string? from, out string? to)
    {
        from = null;
        to = null;
        if (!Uri.TryCreate(uriString, UriKind.Absolute, out var uri) || string.IsNullOrEmpty(uri.Query))
        {
            return;
        }

        foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq <= 0) continue;
            var key = Uri.UnescapeDataString(part[..eq]);
            var val = Uri.UnescapeDataString(part[(eq + 1)..]);
            if (string.Equals(key, "from", StringComparison.OrdinalIgnoreCase)) from = val;
            else if (string.Equals(key, "to", StringComparison.OrdinalIgnoreCase)) to = val;
        }
    }

    private string BuildUri(DateRange range, string? incident)
    {
        var from = range.From.ToString("yyyy-MM", CultureInfo.InvariantCulture);
        var to = range.To.ToString("yyyy-MM", CultureInfo.InvariantCulture);
        var uri = $"/articles/{PageId.ToString(CultureInfo.InvariantCulture)}?from={from}&to={to}";
        if (!string.IsNullOrWhiteSpace(incident))
        {
            uri += $"&incident={Uri.EscapeDataString(incident)}";
        }

        return uri;
    }

    internal static string FormatHeaderCounts(ArticleAggregates a)
    {
        var revNoun = a.Revisions == 1 ? "revision" : "revisions";
        var years = a.FirstEdit.Year == a.LastEdit.Year
            ? a.FirstEdit.Year.ToString(CultureInfo.InvariantCulture)
            : $"{a.FirstEdit.Year.ToString(CultureInfo.InvariantCulture)}\u2013{a.LastEdit.Year.ToString(CultureInfo.InvariantCulture)}";
        return $"{a.Revisions.ToString("N0", CultureInfo.InvariantCulture)} {revNoun} {years}";
    }

    internal static string FormatRangeHeading(DateRange range)
    {
        var fromStr = range.From.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
        var inclusiveEnd = range.To.AddDays(-1);
        if (inclusiveEnd < range.From)
        {
            inclusiveEnd = range.From;
        }

        var toStr = inclusiveEnd.ToString("d MMM yyyy", CultureInfo.InvariantCulture);
        return $"{fromStr} \u2013 {toStr}";
    }

    internal static string FormatTimestamp(DateTime ts)
    {
        var utc = ts.Kind == DateTimeKind.Local ? ts.ToUniversalTime() : DateTime.SpecifyKind(ts, DateTimeKind.Utc);
        return utc.ToString("d MMM yyyy, HH:mm 'UTC'", CultureInfo.InvariantCulture);
    }

    internal static string FormatDeltaBytes(int delta) =>
        delta > 0
            ? $"+{delta.ToString("N0", CultureInfo.InvariantCulture)}"
            : delta.ToString("N0", CultureInfo.InvariantCulture);

    private CancellationToken ResetCancellation()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        return _cts.Token;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

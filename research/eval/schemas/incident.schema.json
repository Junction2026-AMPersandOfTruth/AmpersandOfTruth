{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident — what a signal variant returns and what the app shows. DRAFT of the #37 output contract; the five required fields are frozen for the eval.",
  "type": "object",
  "required": ["page_id", "inserting_rev_ids", "removing_rev_ids", "tier", "score"],
  "additionalProperties": true,
  "properties": {
    "page_id": { "type": "integer", "minimum": 1, "description": "Article of the first insertion (fi page id)." },
    "other_page_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "inserting_rev_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 }, "description": "Every revision that added or re-added the content. The eval matches on these." },
    "removing_rev_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 }, "description": "Every revision that took it out, oldest first." },
    "tier": { "enum": ["reverted", "contested", "campaign"], "description": "EvidenceTiers ids. No assessment yet → reverted." },
    "score": { "type": "number", "description": "Higher = stronger. Informational: rank is the array order." },

    "id": { "type": "string" },
    "claim_en": { "type": ["string", "null"] },
    "claim_fi": { "type": ["string", "null"] },
    "summary_en": { "type": ["string", "null"] },
    "narrative": { "type": ["string", "null"] },
    "category": { "enum": ["vandalism", "test_or_nonsense", "good_faith_error", "content_dispute", "pov_push", "false_factual_claim", "source_manipulation", "other", null] },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_id"],
        "additionalProperties": true,
        "properties": {
          "page_id": { "type": "integer", "minimum": 1 },
          "title_fi": { "type": ["string", "null"] },
          "title_en": { "type": ["string", "null"] }
        }
      }
    },
    "first_inserted_at": { "type": ["string", "null"], "description": "UTC, ISO 8601 with Z." },
    "last_removed_at": { "type": ["string", "null"], "description": "UTC, ISO 8601 with Z." },
    "total_exposure_seconds": { "type": ["integer", "null"], "minimum": 0, "description": "Sum of the windows in which the content was live." },
    "reinsertion_count": { "type": ["integer", "null"], "minimum": 0 },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rev_id", "role"],
        "additionalProperties": true,
        "properties": {
          "rev_id": { "type": "integer", "minimum": 1 },
          "parent_rev_id": { "type": ["integer", "null"] },
          "page_id": { "type": "integer", "minimum": 1 },
          "user_display": { "type": ["string", "null"], "description": "EditorDisplay.For(user).PlainText — IPs masked. Never the raw user string." },
          "is_anonymous": { "type": ["boolean", "null"] },
          "timestamp": { "type": ["string", "null"], "description": "UTC, ISO 8601 with Z." },
          "role": { "enum": ["inserted", "removed", "reinserted"] },
          "summary": { "type": ["string", "null"], "description": "EditorDisplay.MaskComment(comment): the edit summary as plain text with every IP address masked. Never the raw comment." },
          "diff_ref": { "type": ["string", "null"] },
          "flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": true,
        "properties": {
          "kind": { "type": "string", "description": "Machine id of the signal, e.g. removal_reason, reinserted, edit_war, multiple_editors." },
          "label": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    },
    "confidence_note": { "type": ["string", "null"] }
  }
}
